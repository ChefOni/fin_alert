# NaijaPay Health environment variables
# Copy to .env.local and fill in. Never commit real secrets.

# Supabase project URL (safe to share)
NEXT_PUBLIC_SUPABASE_URL=https://grqclcwwqodibpgfuhcq.supabase.co

# Supabase publishable key (public — safe in the browser; enforced by RLS)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Optional / advanced ---
# A server-only secret key avoids needing a public INSERT policy entirely.
# Prefer this (new key format) over the legacy service_role JWT:
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_SERVICE_ROLE_KEY=

# Protect the poll cron endpoint in production
# CRON_SECRET= ebe1e2a3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f

# Enable the authenticated Bachs gateway probe (falls back to a public reachability probe)
# BACHS_API_KEY=

# Supabase personal access token (sbp_...) — only needed to run `pnpm db:create-feedback`
# SUPABASE_ACCESS_TOKEN=
